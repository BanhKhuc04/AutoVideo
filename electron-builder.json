{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.vanhkhuc.youtubeclipstudio",
  "productName": "YouTubeClipStudio",
  "directories": {
    "output": "release",
    "buildResources": "assets"
  },
  "files": [
    "dist-electron/**/*",
    "client/dist/**/*",
    "server/dist/**/*",
    "assets/**/*",
    "package.json",
    "node_modules/**/*"
  ],
  "extraResources": [
    {
      "from": "server/bin",
      "to": "bin",
      "filter": ["**/*"]
    },
    {
      "from": "config",
      "to": "config",
      "filter": ["**/*"]
    }
  ],
  "publish": {
    "provider": "github",
    "owner": "BanhKhuc04",
    "repo": "AutoVideo"
  },
  "forceCodeSigning": false,
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "assets/icon.ico",
    "executableName": "YouTubeClipStudio",
    "signAndEditExecutable": false
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "allowElevation": true,
    "createDesktopShortcut": "always",
    "createStartMenuShortcut": true,
    "shortcutName": "YouTube Clip Studio",
    "installerIcon": "assets/icon.ico",
    "uninstallerIcon": "assets/icon.ico",
    "artifactName": "YouTubeClipStudio-Setup-${version}.${ext}",
    "differentialPackage": true
  },
  "portable": {
    "artifactName": "YouTubeClipStudio-Portable-${version}.${ext}"
  }
}
