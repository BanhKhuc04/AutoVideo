{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.vanhkhuc.youtubeclipstudio",
  "productName": "YouTubeClipStudio",
  "directories": {
    "output": "release",
    "buildResources": "assets"
  },
  "files": [
    "dist-electron/**/*",
    "client/dist/**/*",
    "server/dist/**/*",
    "assets/**/*",
    "package.json",
    "node_modules/**/*",
    "!node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
    "!node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
    "!node_modules/*.d.ts",
    "!node_modules/.bin"
  ],
  "extraResources": [
    {
      "from": "server/bin",
      "to": "bin",
      "filter": ["**/*"]
    },
    {
      "from": "config",
      "to": "config",
      "filter": ["**/*"]
    }
  ],
  "win": {
    "target": [
      {
        "target": "dir",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "assets/icon.ico",
    "executableName": "YouTubeClipStudio"
  },
  "portable": {
    "artifactName": "YouTubeClipStudio.${ext}",
    "requestExecutionLevel": "user"
  }
}
